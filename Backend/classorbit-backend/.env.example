ENVIRONMENT=development
DATABASE_URL=sqlite:///./classorbit.db
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOADS_DIR=uploads
MAX_UPLOAD_MB=25
# Explicit physical room/lab values from valid timetable entries become classroom master records.
CREATE_MISSING_CLASSROOMS_FROM_IMPORT=true
# Optional on Windows; the standard Program Files location is detected automatically.
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
